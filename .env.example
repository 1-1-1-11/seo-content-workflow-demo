# 复制为 .env 后按需修改。mock 演示不读取密钥。
#   cp .env.example .env
#
# 优先级：命令行 > 已导出的环境变量 > 本文件 > 内置默认值。
# 本文件不会覆盖进程里已经存在的变量。

# 关键词。也可以用 --keyword 传入。
SEO_DEMO_KEYWORD=industrial gearbox motor

# mock | preview | publish
# preview 和 publish 在这个仓库里不会访问外网，也不会真正发布。
SEO_DEMO_MODE=mock

# 品牌配置。默认是仓库里的示例 profile。
SEO_DEMO_PROFILE=config/prompt_profile.example.yaml

# 产物目录。已被 .gitignore 忽略。
SEO_DEMO_OUT=artifacts

# 可选：从其他路径加载 env 文件。
# SEO_DEMO_ENV_FILE=.env

# 下面这些不是本演示读取的变量。接入真实客户端时只放在未提交的 .env 里。
# SEO_DEMO_LLM_API_KEY=replace-me
# SEO_DEMO_LLM_BASE_URL=https://api.example.com/v1
# SEO_DEMO_LLM_MODEL=your-model-name
# SEO_DEMO_SERP_API_KEY=replace-me
# SEO_DEMO_WP_BASE_URL=https://cms.example.com
# SEO_DEMO_WP_USERNAME=replace-me
# SEO_DEMO_WP_APP_PASSWORD=replace-me
